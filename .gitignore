# Track source code and project documentation only. Everything else is data or generated output.
/*
!/.gitignore
!/README.md
!/PROJECT_HISTORY.md

!/OriginalDataset/
/OriginalDataset/*
!/OriginalDataset/*.py

!/OriginalDataset-filter/
/OriginalDataset-filter/*
!/OriginalDataset-filter/README.md
!/OriginalDataset-filter/scripts/
/OriginalDataset-filter/scripts/*
!/OriginalDataset-filter/scripts/*.py

!/OriginalDataset-filter-1k/
/OriginalDataset-filter-1k/*
!/OriginalDataset-filter-1k/README.md
!/OriginalDataset-filter-1k/*.py

!/ProcessedDataset/
/ProcessedDataset/*
!/ProcessedDataset/UnifiedTrace/
/ProcessedDataset/UnifiedTrace/*
!/ProcessedDataset/UnifiedTrace/README.md
!/ProcessedDataset/UnifiedTrace/scripts/
/ProcessedDataset/UnifiedTrace/scripts/*
!/ProcessedDataset/UnifiedTrace/scripts/*.py
