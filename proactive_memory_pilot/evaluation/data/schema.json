{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controlled pilot scenario",
  "type": "object",
  "required": ["scenario_id", "initial_context", "events", "task_registry", "evaluations"],
  "properties": {
    "scenario_id": {"type": "string", "minLength": 1},
    "initial_context": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "events": {"type": "array", "items": {"type": "object", "required": ["event_id", "timestamp", "source", "content"], "properties": {"event_id": {"type": "string"}, "timestamp": {"type": "string"}, "source": {"type": "string"}, "content": {"type": "string"}}}},
    "task_registry": {"type": "array", "items": {"type": "object", "required": ["task_id", "description", "goal", "conditions", "required_memory_facts", "matching_guidelines"], "properties": {"task_id": {"type": "string"}, "description": {"type": "string"}, "goal": {"type": "string"}, "conditions": {"type": "array", "items": {"type": "string"}}, "required_memory_facts": {"type": "array", "items": {"type": "string"}}, "matching_guidelines": {"type": "string"}}}},
    "evaluations": {"type": "array", "items": {"type": "object", "required": ["stage_id", "after_event_id", "memory_questions", "reactive_questions", "ready_tasks", "newly_ready_tasks", "invalidated_tasks", "task_states"], "properties": {"stage_id": {"type": "string"}, "after_event_id": {"type": ["string", "null"]}, "memory_questions": {"type": "array", "items": {"type": "object", "required": ["question_id", "question", "task_ids", "ground_truth_answer"], "properties": {"question_id": {"type": "string"}, "question": {"type": "string"}, "task_ids": {"type": "array", "items": {"type": "string"}}, "ground_truth_answer": {"type": "string"}}}}, "reactive_questions": {"type": "array", "items": {"type": "string"}}, "ready_tasks": {"type": "array", "items": {"type": "string"}}, "newly_ready_tasks": {"type": "array", "items": {"type": "string"}}, "invalidated_tasks": {"type": "array", "items": {"type": "string"}}, "task_states": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"enum": ["Satisfied", "Unsatisfied", "Unknown"]}}}}}}
  },
  "$defs": {"record": {"type": "object", "required": ["record_id", "timestamp", "source", "content"], "properties": {"record_id": {"type": "string"}, "timestamp": {"type": "string"}, "source": {"type": "string"}, "content": {"type": "string"}}}}
}
